<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DLSS_Swapper.Linux.Converters"
        xmlns:vm="clr-namespace:DLSS_Swapper.Linux.ViewModels"
        x:Class="DLSS_Swapper.Linux.Views.MainWindow"
        Title="DLSS Swapper"
        Width="1024" Height="768">
    <Window.Resources>
        <converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
    </Window.Resources>
    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <TextBlock Text="DLSS Swapper" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="120" Margin="8,0,0,0"/>
        </StackPanel>
        <!-- Body -->
        <Grid ColumnDefinitions="200,*">
            <!-- Sidebar -->
            <ListBox Grid.Column="0">
                <ListBoxItem>Steam</ListBoxItem>
            </ListBox>
            <!-- Game List -->
            <Grid Grid.Column="1">
                <TextBlock Text="No games found." IsVisible="{Binding HasNoGames}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ListBox ItemsSource="{Binding Games}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="70,*" Margin="4">
                                <Image Grid.Column="0" Source="{Binding CoverImage, Converter={StaticResource StringToBitmapConverter}}" Width="60" Height="90" Stretch="UniformToFill"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                    <Button Content="Manage DLLs"
                                            IsEnabled="{Binding !Processing}"
                                            Command="{Binding DataContext.OpenSwapDialogCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
