<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DLSS.Swapper.UnoLinux.Pages.AcknowledgementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:DLSS.Swapper.UnoLinux.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title -->
            <RowDefinition Height="*"/>     <!-- master/detail -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Acknowledgements"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Padding="12,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Master: list of libraries -->
            <ListView Grid.Column="0"
                      ItemsSource="{x:Bind ViewModel.Acknowledgements}"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="pages:AcknowledgementItem">
                        <TextBlock Text="{x:Bind Name}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Detail: read-only plain text -->
            <ScrollViewer Grid.Column="1" Padding="16,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{x:Bind ViewModel.DetailText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
