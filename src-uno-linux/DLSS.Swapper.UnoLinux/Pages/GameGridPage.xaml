<Page
    x:Class="DLSS.Swapper.UnoLinux.Pages.GameGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:DLSS.Swapper.UnoLinux.Converters"
    xmlns:data="using:DLSS_Swapper.Core.Data">
    <Page.Resources>
        <conv:StringToImageSourceConverter x:Key="CoverConverter"/>
    </Page.Resources>
    <Grid RowDefinitions="Auto,*">
        <!-- Filter bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="16,8" Spacing="12" VerticalAlignment="Center">
            <ToggleSwitch x:Name="FilterToggle"
                          Header="Só jogos com DLLs"
                          IsOn="{x:Bind ViewModel.HideNonSwappable, Mode=TwoWay}"
                          OffContent="" OnContent=""/>
        </StackPanel>

        <!-- Loading indicator -->
        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="60" Height="60"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Game grid -->
        <GridView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.FilteredGames, Mode=OneWay}"
                  Padding="16"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ItemClick="OnGameItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="data:GameBase">
                    <StackPanel Width="200" Margin="8">
                        <Image Source="{x:Bind CoverImage, Converter={StaticResource CoverConverter}, Mode=OneWay}"
                               Width="200" Height="300" Stretch="UniformToFill"/>
                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
